PROGRAM "program" [MQ] version=0.3.0

  ROUTINE "h_rz" Gate
    params: ang:angle
    returns: void
    BODY
      H [0]
      RZ(ang) [1]

  ROUTINE "teleport" Operation
    params: msg:qubit anc:qubit target:qubit
    returns: void
    BODY
      X [10] ctrl=[9:|1>]
      H [11]
      MEASURE [12] -> c[0]
      MEASURE [13] -> c[1]
      X [14] if(c[1] == 1)
      Z [15] if(c[0] == 1)

  CIRCUIT "bell" qubits=2 cbits=2 global_phase=0
    registers:
      Q "q" size=2 base=0
      C "c" size=2 base=0
    BODY
      H [2]
      X [4] ctrl=[3:|1>]
      MEASURE [5] -> c[0]
      MEASURE [6] -> c[1]
      IF ((c[0] == 1)) {
        X [7]
      }

  CIRCUIT "parametric" qubits=1 cbits=1 global_phase=0
    registers:
      Q "q" size=1 base=0
      C "c" size=1 base=0
    params: phi
    BODY
      phi = (sin(theta) * 2)
      h_rz(phi)
      MEASURE [8] -> c[0]

