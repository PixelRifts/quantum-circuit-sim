circuit Main {
    qubit qs[3];

    // // allocate 3 qubits
    Message("Initial state |000>:");
    DumpMachine();
    // // -------- QFT START --------
    // // Qubit 0
    H qs[0];
    ctrl[qs[1]] P((PI() / 2)) qs[0];
    ctrl[qs[2]] P((PI() / 4)) qs[0];
    // // Qubit 1
    H qs[1];
    ctrl[qs[2]] P((PI() / 2)) qs[1];
    // // Qubit 2
    H qs[2];
    // // Swap qubits (reverse order)
    SWAP qs[0] qs[2];
    // // -------- QFT END --------
    Message("After QFT:");
    DumpMachine();
    // // Reset qubits
    ResetAll(qs);
}

