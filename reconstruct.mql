gate h_rz(q : qubit, theta : angle) {
    H q;
    RZ(theta) q;
}

operation teleport(msg : qubit, anc : qubit, target : qubit, c : bit[2]) {
    ctrl[msg] X anc;
    H msg;
    measure msg -> c[0];
    measure anc -> c[1];
    X target if c[1] == 1;
    Z target if c[0] == 1;
}

circuit bell {
    qubit q[2];
    bit c[2];

    H q[0];
    ctrl[q[0]] X q[1];
    measure q[0] -> c[0];
    measure q[1] -> c[1];
    if (c[0] == 1) {
        X q[0];
    }
}

circuit parametric(phi : angle) {
    qubit q;
    bit c;
    param phi;

    set phi = (sin(theta) * 2);
    h_rz(phi);
    measure q -> c[0];
}

