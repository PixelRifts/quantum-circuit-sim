// Bell state circuit
gate h_rz(ang: angle) {
    H       q[0];
    RZ(ang) q[0];
}

circuit bell {
    qubit q[2];
    bit   c[2];

    H    q[0];
    CNOT q[0] -> q[1];
    measure q[0] -> c[0];
    measure q[1] -> c[1];
    if c[0] == 1 { X q[0]; }
}

// Parametric circuit with symbolic angle
circuit parametric(theta: angle) {
    qubit q[1];
    bit   c[1];

    param phi;

    set phi = sin(theta) * 2.0;
    h_rz(phi);
    measure q[0] -> c[0];
}

// Dynamic qubit allocation and classical feedback
operation teleport(msg: qubit, anc: qubit, target: qubit) {
    CNOT msg      -> anc;
    H    msg;
    measure msg   -> c[0];
    measure anc   -> c[1];
    X target if c[1] == 1;
    Z target if c[0] == 1;
}


